rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 小仙女養成計畫（diet-log）=====
    // 只有下面列出的 Gmail 登入後可以讀寫（兩個帳號共用同一份資料）
    // ⚠️ 這個檔案是公開的，所以這裡只放空白；真正的 Gmail 只填在 Firebase 後台的規則裡
    function isYui() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['填第一個Gmail', '填第二個Gmail'];
    }
    match /dietlog_users/yui {
      allow read, write: if isYui();
    }
    match /dietlog_users/yui/{rest=**} {
      allow read, write: if isYui();
    }

    // ===== 嘟嘟一家（home-hub）原本的資料，維持原本的開放設定 =====
    // 這些 App 沒有登入功能，所以保持可以讀寫，以免原本的 App 壞掉
    match /items/{id=**}          { allow read, write: if true; }
    match /quicknotes/{id=**}     { allow read, write: if true; }
    match /shopping/{id=**}       { allow read, write: if true; }
    match /articles/{id=**}       { allow read, write: if true; }
    match /reminders/{id=**}      { allow read, write: if true; }
    match /wiki/{id=**}           { allow read, write: if true; }
    match /inventory/{id=**}      { allow read, write: if true; }
    match /wardrobe/{id=**}       { allow read, write: if true; }
    match /todos/{id=**}          { allow read, write: if true; }
    match /memo/{id=**}           { allow read, write: if true; }
    match /diary_entries/{id=**}  { allow read, write: if true; }
    match /diary_settings/{id=**} { allow read, write: if true; }
  }
}
